# Copy this file to .env (same folder) and put your own values in it.
# .env is ignored by git, so your key never goes to GitHub.

# Claude (optional): your key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to use (optional). Sonnet is the balance of speed and cost.
# LS_CLAUDE_MODEL=claude-sonnet-5-5
